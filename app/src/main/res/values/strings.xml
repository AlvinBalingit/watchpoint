    <string name="terms_title">Terms of Service</string>
    <string name="terms_updated">Last updated: September 14, 2026</string>
    <string name="terms_intro">By using WatchPoint, you agree to these terms. WatchPoint is a daily mental fitness and reflection companion for CCJEF students.</string>
    <string name="terms_use_title">Using WatchPoint</string>
    <string name="terms_use_body">Use the app honestly and only for your own personal, non-commercial well-being activities. Keep your account information accurate and do not attempt to access another person\'s account or disrupt the service.</string>
    <string name="terms_content_title">Your entries</string>
    <string name="terms_content_body">You keep ownership of the journal entries, exercise notes, and reflections you create. You give WatchPoint permission to store and process them only to provide the app\'s features, backup, and synchronization.</string>
    <string name="terms_health_title">Not medical advice</string>
    <string name="terms_health_body">WatchPoint is not a doctor, therapist, emergency service, or substitute for professional care. If you may be in immediate danger or need urgent help, contact local emergency services or a qualified mental-health professional.</string>
    <string name="terms_availability_title">Service changes</string>
    <string name="terms_availability_body">We may improve, change, suspend, or discontinue features when reasonably necessary. We will make reasonable efforts to protect your stored information and communicate material changes where appropriate.</string>
    <string name="terms_contact_title">Questions</string>
    <string name="terms_contact_body">For questions about these terms or your account, contact the WatchPoint support team through the app owner or organization that provided this application.</string>
    <string name="privacy_title">Privacy Policy</string>
    <string name="privacy_updated">Last updated: September 14, 2026</string>
    <string name="privacy_intro">WatchPoint respects your privacy. This notice explains how personal information is handled in the Philippines under Republic Act No. 10173, the Data Privacy Act of 2012, and its implementing rules.</string>
    <string name="privacy_collect_title">Information we collect</string>
    <string name="privacy_collect_body">We may collect your account details, onboarding answers, check-in responses, journal entries, exercise notes, reminder preferences, and basic technical or synchronization information needed to operate the app.</string>
    <string name="privacy_use_title">How we use information</string>
    <string name="privacy_use_body">We use information to authenticate you, save your reflections, show your personal progress, provide reminders, improve app reliability, and synchronize your data when that feature is enabled. We do not use your journal or exercise notes for advertising.</string>
    <string name="privacy_share_title">Sharing and disclosure</string>
    <string name="privacy_share_body">We do not sell your personal information. We may share limited information with service providers that help operate authentication, storage, synchronization, or notifications, subject to appropriate confidentiality and security safeguards, or when required by law.</string>
    <string name="privacy_retention_title">Storage and retention</string>
    <string name="privacy_retention_body">Information is retained only as long as reasonably necessary to provide the service, meet legal obligations, resolve disputes, and protect the app. You may request correction or deletion of information, subject to applicable law and technical or legal limitations.</string>
    <string name="privacy_security_title">Security</string>
    <string name="privacy_security_body">We use reasonable organizational, physical, and technical safeguards to protect information from unauthorized access, loss, misuse, or disclosure. No online service can guarantee absolute security.</string>
    <string name="privacy_rights_title">Your Philippine privacy rights</string>
    <string name="privacy_rights_body">Under the Data Privacy Act, you may have rights to be informed, access, object, correct, erase or block, data portability, and to file a complaint with the National Privacy Commission. Requests may be subject to identity verification and legal exceptions.</string>
    <string name="privacy_contact_title">Privacy questions and requests</string>
    <string name="privacy_contact_body">To ask about your information or exercise your rights, contact the WatchPoint support team through the app owner or organization that provided this application. You may also contact the Philippine National Privacy Commission at privacy.gov.ph.</string>
