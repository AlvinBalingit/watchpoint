    <string name="exercise_breathing_title">4-Count Breathing</string>
    <string name="exercise_breathing_desc">A slow breathing pattern to ease tension in a couple of minutes.</string>
    <string name="exercise_breathing_step1">Breathe in slowly for 4 counts.</string>
    <string name="exercise_breathing_step2">Hold gently for 4 counts.</string>
    <string name="exercise_breathing_step3">Breathe out slowly for 4 counts.</string>
    <string name="exercise_breathing_step4">Repeat 4-6 times, letting your shoulders drop.</string>

    <string name="exercise_grounding_title">5-4-3-2-1 Grounding</string>
    <string name="exercise_grounding_desc">Use your senses to settle back into the present moment.</string>
    <string name="exercise_grounding_step1">Notice 5 things you can see.</string>
    <string name="exercise_grounding_step2">Notice 4 things you can touch.</string>
    <string name="exercise_grounding_step3">Notice 3 things you can hear.</string>
    <string name="exercise_grounding_step4">Notice 2 things you can smell.</string>
    <string name="exercise_grounding_step5">Notice 1 thing you can taste.</string>

    <string name="exercise_gratitude_title">Gratitude Note</string>
    <string name="exercise_gratitude_desc">A quick note to shift focus toward what\'s going okay.</string>
    <string name="exercise_gratitude_step1">Think of one small thing that went well recently.</string>
    <string name="exercise_gratitude_step2">Write a sentence about why it mattered.</string>
    <string name="exercise_gratitude_step3">Read it back once before moving on.</string>

    <string name="exercise_braindump_title">Brain Dump</string>
    <string name="exercise_braindump_desc">Get everything out of your head and onto paper.</string>
    <string name="exercise_braindump_step1">Set a timer for 3-5 minutes.</string>
    <string name="exercise_braindump_step2">Write down everything on your mind, no editing.</string>
    <string name="exercise_braindump_step3">Circle the one thing that actually needs action today.</string>

    <string name="exercise_movement_title">Short Movement Break</string>
    <string name="exercise_movement_desc">A quick reset for your body between tasks.</string>
    <string name="exercise_movement_step1">Stand up and stretch your arms overhead.</string>
    <string name="exercise_movement_step2">Walk for 5 minutes, indoors or outside.</string>
    <string name="exercise_movement_step3">Notice how your body feels before you sit back down.</string>

    <string name="exercise_rest_title">Wind-Down Routine</string>
    <string name="exercise_rest_desc">A short routine to help you ease into rest.</string>
    <string name="exercise_rest_step1">Dim the lights and put your phone aside.</string>
    <string name="exercise_rest_step2">Take a few slow breaths.</string>
    <string name="exercise_rest_step3">Think of one thing you\'re looking forward to tomorrow.</string>

    <string name="exercise_bodyscan_title">Quick Body Scan</string>
    <string name="exercise_bodyscan_desc">Notice where you\'re holding tension and release it.</string>
    <string name="exercise_bodyscan_step1">Starting at your head, notice any tight spots.</string>
    <string name="exercise_bodyscan_step2">Slowly move your attention down to your feet.</string>
    <string name="exercise_bodyscan_step3">Take one deep breath and let your shoulders relax.</string>

    <string name="exercise_preexam_title">Pre-Exam Reset</string>
    <string name="exercise_preexam_desc">A quick reset to steady your nerves before a review session or board exam.</string>
    <string name="exercise_preexam_step1">Put your reviewer down and sit up straight.</string>
    <string name="exercise_preexam_step2">Take 4 slow breaths, in through your nose and out through your mouth.</string>
    <string name="exercise_preexam_step3">Remind yourself of one topic you already know well.</string>
    <string name="exercise_preexam_step4">Go back to reviewing one small section at a time.</string>

